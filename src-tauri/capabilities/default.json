{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Finestra principale: dialoghi, file system (cartella pratiche e archivi scelti dall'utente), apertura dei PDF",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }, { "path": "$APPDATA/**" }, { "path": "$HOME/**" }],
      "requireLiteralLeadingDot": false
    }
  ]
}
